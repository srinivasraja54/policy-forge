# Phase 2 - compiler
ANTHROPIC_API_KEY=sk-ant-...

# Phase 3 - Slack ingestion
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_IDS=C01234567,C07654321

# Phase 4 - GitHub output (policyctl remediate --pr)
# Fine-grained PAT scoped to the specific repo(s) you'll run --pr against:
# Contents (read/write) + Pull requests (read/write). No org/repo setting here
# -- the target's own git remote (`origin`) decides where the PR opens.
POLICYFORGE_GITHUB_TOKEN=github_pat_...

# Local paths
POLICYFORGE_REGISTRY=./registry
POLICYFORGE_LEDGER=./ledger.sqlite
